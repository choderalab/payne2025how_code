// 04-specific params only — conda envs and common paths come from ../nextflow.config

// settings files (evaluator factory YAML configs)
params.configFiles = "${params.repoPath}/config_files"
params.evaluator_configs = "${params.configFiles}/evaluator_configs"

// evaluation results output
params.evaluationResults = "${params.dataPath}/analyzed_results"
params.datesplitPositResults = "${params.evaluationResults}/datesplit_posit_combined_results.csv"

// figure params
params.figuresPath = "${params.dataPath}/figures"